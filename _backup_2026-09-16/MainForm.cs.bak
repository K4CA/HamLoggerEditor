using System.ComponentModel;
using System.Globalization;
using HamLogger.Models;
using HamLoggerEditor.Adif;

namespace HamLoggerEditor;

public sealed class MainForm : Form
{
    private readonly BindingList<Contact> contacts = [];
    private readonly BindingSource source = new();
    private readonly DataGridView grid = new();
    private readonly ToolStripStatusLabel status = new();
    private string? currentPath;

    public MainForm()
    {
        Text = "HamLogger Contact Editor";
        StartPosition = FormStartPosition.CenterScreen;
        Width = 1450;
        Height = 750;

        var menu = BuildMenu();
        var toolBar = BuildToolBar();
        var statusStrip = new StatusStrip();
        statusStrip.Items.Add(status);

        source.DataSource = contacts;
        grid.DataSource = source;
        grid.Dock = DockStyle.Fill;
        grid.AutoGenerateColumns = false;
        grid.AllowUserToAddRows = false;
        grid.MultiSelect = true;
        grid.SelectionMode = DataGridViewSelectionMode.FullRowSelect;
        grid.AutoSizeRowsMode = DataGridViewAutoSizeRowsMode.DisplayedCells;
        grid.DataError += Grid_DataError;
        grid.CellEndEdit += (_, _) => UpdateStatus("Contact edited");
        ConfigureColumns();

        Controls.Add(grid);
        Controls.Add(toolBar);
        Controls.Add(menu);
        Controls.Add(statusStrip);
        MainMenuStrip = menu;
        FormClosing += MainForm_FormClosing;
        UpdateStatus("Ready");
    }

    private MenuStrip BuildMenu()
    {
        var menu = new MenuStrip();
        var file = new ToolStripMenuItem("&File");
        file.DropDownItems.Add("&New", null, (_, _) => NewFile());
        file.DropDownItems.Add("&Open ADIF...", null, (_, _) => OpenFile());
        file.DropDownItems.Add("&Save", null, (_, _) => SaveFile(false));
        file.DropDownItems.Add("Save &As...", null, (_, _) => SaveFile(true));
        file.DropDownItems.Add(new ToolStripSeparator());
        file.DropDownItems.Add("E&xit", null, (_, _) => Close());
        var edit = new ToolStripMenuItem("&Edit");
        edit.DropDownItems.Add("&Add Contact", null, (_, _) => AddContact());
        edit.DropDownItems.Add("&Delete Selected", null, (_, _) => DeleteSelected());
        menu.Items.Add(file);
        menu.Items.Add(edit);
        return menu;
    }

    private ToolStrip BuildToolBar()
    {
        var bar = new ToolStrip { GripStyle = ToolStripGripStyle.Hidden };
        bar.Items.Add("Open ADIF", null, (_, _) => OpenFile());
        bar.Items.Add("Save ADIF", null, (_, _) => SaveFile(false));
        bar.Items.Add(new ToolStripSeparator());
        bar.Items.Add("Add Contact", null, (_, _) => AddContact());
        bar.Items.Add("Delete Selected", null, (_, _) => DeleteSelected());
        bar.Dock = DockStyle.Top;
        return bar;
    }

    private void ConfigureColumns()
    {
        AddColumn(nameof(Contact.Id), "ID", 60, "0");
        AddColumn(nameof(Contact.Call), "Call", 90);
        AddColumn(nameof(Contact.Band), "Band", 70);
        AddColumn(nameof(Contact.Mode), "Mode", 75);
        AddColumn(nameof(Contact.QsoDate), "QSO Date", 95, "yyyy-MM-dd");
        AddColumn(nameof(Contact.TimeOn), "Time On", 85, @"hh\:mm\:ss");
        AddColumn(nameof(Contact.Frequency), "Frequency (MHz)", 110, "0.######");
        AddColumn(nameof(Contact.RstSent), "RST Sent", 75);
        AddColumn(nameof(Contact.RstReceived), "RST Rcvd", 75);
        AddColumn(nameof(Contact.Name), "Name", 100);
        AddColumn(nameof(Contact.Qth), "QTH", 110);
        AddColumn(nameof(Contact.GridSquare), "Grid", 75);
        AddColumn(nameof(Contact.State), "State", 65);
        AddColumn(nameof(Contact.Country), "Country", 110);
        AddColumn(nameof(Contact.Comments), "Comments", 240);
    }

    private void AddColumn(string property, string title, int width, string? format = null)
    {
        var column = new DataGridViewTextBoxColumn
        {
            Name = property,
            DataPropertyName = property,
            HeaderText = title,
            Width = width,
            SortMode = DataGridViewColumnSortMode.Automatic
        };
        if (format is not null) column.DefaultCellStyle.Format = format;
        grid.Columns.Add(column);
    }

    private void NewFile()
    {
        contacts.Clear();
        currentPath = null;
        Text = "HamLogger Contact Editor";
        UpdateStatus("New contact list");
    }

    private void OpenFile()
    {
        using var dialog = new OpenFileDialog
        {
            Filter = "ADIF files (*.adi;*.adif)|*.adi;*.adif|All files (*.*)|*.*",
            Title = "Open ADIF Log"
        };
        if (dialog.ShowDialog(this) != DialogResult.OK) return;
        try
        {
            List<Contact> loaded = AdifFile.Load(dialog.FileName);
            contacts.RaiseListChangedEvents = false;
            contacts.Clear();
            foreach (Contact contact in loaded) contacts.Add(contact);
            contacts.RaiseListChangedEvents = true;
            contacts.ResetBindings();
            currentPath = dialog.FileName;
            Text = $"HamLogger Contact Editor - {Path.GetFileName(currentPath)}";
            UpdateStatus($"Loaded {contacts.Count:N0} contacts");
        }
        catch (Exception ex)
        {
            MessageBox.Show(this, ex.Message, "Unable to open ADIF", MessageBoxButtons.OK, MessageBoxIcon.Error);
        }
    }

    private bool SaveFile(bool saveAs)
    {
        grid.EndEdit();
        source.EndEdit();
        string? path = currentPath;
        if (saveAs || string.IsNullOrWhiteSpace(path))
        {
            using var dialog = new SaveFileDialog
            {
                Filter = "ADIF files (*.adi)|*.adi|ADIF files (*.adif)|*.adif|All files (*.*)|*.*",
                DefaultExt = "adi",
                AddExtension = true,
                FileName = path is null ? "contacts.adi" : Path.GetFileName(path)
            };
            if (dialog.ShowDialog(this) != DialogResult.OK) return false;
            path = dialog.FileName;
        }
        try
        {
            AdifFile.Save(path, contacts);
            currentPath = path;
            Text = $"HamLogger Contact Editor - {Path.GetFileName(currentPath)}";
            UpdateStatus($"Saved {contacts.Count:N0} contacts");
            return true;
        }
        catch (Exception ex)
        {
            MessageBox.Show(this, ex.Message, "Unable to save ADIF", MessageBoxButtons.OK, MessageBoxIcon.Error);
            return false;
        }
    }

    private void AddContact()
    {
        long id = contacts.Count == 0 ? 1 : contacts.Max(c => c.Id) + 1;
        var contact = new Contact { Id = id, QsoDate = DateTime.Today, TimeOn = DateTime.Now.TimeOfDay };
        contacts.Add(contact);
        int row = contacts.Count - 1;
        grid.ClearSelection();
        grid.Rows[row].Selected = true;
        grid.CurrentCell = grid.Rows[row].Cells[nameof(Contact.Call)];
        grid.BeginEdit(true);
        UpdateStatus("Contact added");
    }

    private void DeleteSelected()
    {
        var selected = grid.SelectedRows.Cast<DataGridViewRow>()
            .Select(r => r.DataBoundItem as Contact).Where(c => c is not null).Cast<Contact>().ToList();
        if (selected.Count == 0) return;
        if (MessageBox.Show(this, $"Delete {selected.Count} selected contact(s)?", "Confirm deletion",
                MessageBoxButtons.YesNo, MessageBoxIcon.Question) != DialogResult.Yes) return;
        foreach (Contact contact in selected) contacts.Remove(contact);
        UpdateStatus($"Deleted {selected.Count} contact(s)");
    }

    private void Grid_DataError(object? sender, DataGridViewDataErrorEventArgs e)
    {
        string column = grid.Columns[e.ColumnIndex].HeaderText;
        MessageBox.Show(this, $"The value entered for {column} is not valid.\n\n" +
            "Date: yyyy-MM-dd\nTime: hh:mm:ss\nFrequency: decimal MHz",
            "Invalid value", MessageBoxButtons.OK, MessageBoxIcon.Warning);
        e.ThrowException = false;
    }

    private void MainForm_FormClosing(object? sender, FormClosingEventArgs e)
    {
        if (contacts.Count == 0) return;
        DialogResult result = MessageBox.Show(this, "Save the contact list before closing?", "HamLogger",
            MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question);
        if (result == DialogResult.Cancel) e.Cancel = true;
        else if (result == DialogResult.Yes && !SaveFile(false)) e.Cancel = true;
    }

    private void UpdateStatus(string message) => status.Text = $"{message}  |  Contacts: {contacts.Count:N0}";
}
