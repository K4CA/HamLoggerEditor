using System.Globalization;
using System.Text;
using System.Text.RegularExpressions;
using HamLogger.Models;

namespace HamLoggerEditor.Adif;

public static partial class AdifFile
{
    public static List<Contact> Load(string path)
    {
        string text = File.ReadAllText(path);
        int headerEnd = text.IndexOf("<EOH>", StringComparison.OrdinalIgnoreCase);
        if (headerEnd >= 0) text = text[(headerEnd + 5)..];

        var contacts = new List<Contact>();
        long nextId = 1;
        foreach (string record in Regex.Split(text, "<EOR>", RegexOptions.IgnoreCase))
        {
            var fields = ParseFields(record);
            if (fields.Count == 0) continue;

            var contact = new Contact
            {
                Id = ParseLong(Get(fields, "APP_HAMLOGGER_ID")) ?? nextId,
                Call = Get(fields, "CALL"),
                Band = Get(fields, "BAND"),
                Mode = Get(fields, "MODE"),
                QsoDate = ParseDate(Get(fields, "QSO_DATE")),
                TimeOn = ParseTime(Get(fields, "TIME_ON")),
                Frequency = ParseDecimal(Get(fields, "FREQ")),
                RstSent = Get(fields, "RST_SENT"),
                RstReceived = Get(fields, "RST_RCVD"),
                Name = Get(fields, "NAME"),
                Qth = Get(fields, "QTH"),
                GridSquare = Get(fields, "GRIDSQUARE"),
                State = Get(fields, "STATE"),
                Country = Get(fields, "COUNTRY"),
                Comments = Get(fields, "COMMENT")
            };
            contacts.Add(contact);
            nextId = Math.Max(nextId + 1, contact.Id + 1);
        }
        return contacts;
    }

    public static void Save(string path, IEnumerable<Contact> contacts)
    {
        using var writer = new StreamWriter(path, false, new UTF8Encoding(false));
        writer.WriteLine("Generated by HamLogger Contact Editor");
        writer.WriteLine("<ADIF_VER:5>3.1.4 <PROGRAMID:9>HamLogger <EOH>");
        writer.WriteLine();
        foreach (Contact c in contacts)
        {
            WriteField(writer, "APP_HAMLOGGER_ID", c.Id.ToString(CultureInfo.InvariantCulture), "N");
            WriteField(writer, "CALL", c.Call);
            WriteField(writer, "BAND", c.Band);
            WriteField(writer, "MODE", c.Mode);
            WriteField(writer, "QSO_DATE", c.QsoDate.ToString("yyyyMMdd", CultureInfo.InvariantCulture), "D");
            WriteField(writer, "TIME_ON", c.TimeOn.ToString(@"hhmmss", CultureInfo.InvariantCulture), "T");
            if (c.Frequency.HasValue) WriteField(writer, "FREQ", c.Frequency.Value.ToString(CultureInfo.InvariantCulture), "N");
            WriteField(writer, "RST_SENT", c.RstSent);
            WriteField(writer, "RST_RCVD", c.RstReceived);
            WriteField(writer, "NAME", c.Name);
            WriteField(writer, "QTH", c.Qth);
            WriteField(writer, "GRIDSQUARE", c.GridSquare);
            WriteField(writer, "STATE", c.State);
            WriteField(writer, "COUNTRY", c.Country);
            WriteField(writer, "COMMENT", c.Comments);
            writer.WriteLine("<EOR>");
        }
    }

    private static Dictionary<string, string> ParseFields(string record)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (Match match in FieldRegex().Matches(record))
        {
            string name = match.Groups["name"].Value;
            if (!int.TryParse(match.Groups["length"].Value, out int length)) continue;
            int valueStart = match.Index + match.Length;
            if (valueStart + length <= record.Length)
                result[name] = record.Substring(valueStart, length);
        }
        return result;
    }

    private static string Get(Dictionary<string, string> fields, string name) =>
        fields.TryGetValue(name, out string? value) ? value.Trim() : string.Empty;

    private static DateTime ParseDate(string value) =>
        DateTime.TryParseExact(value, "yyyyMMdd", CultureInfo.InvariantCulture,
            DateTimeStyles.None, out DateTime date) ? date : DateTime.Today;

    private static TimeSpan ParseTime(string value)
    {
        string format = value.Length >= 6 ? "hhmmss" : "hhmm";
        return TimeSpan.TryParseExact(value, format, CultureInfo.InvariantCulture,
            out TimeSpan time) ? time : TimeSpan.Zero;
    }

    private static decimal? ParseDecimal(string value) =>
        decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal n) ? n : null;

    private static long? ParseLong(string value) =>
        long.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out long n) ? n : null;

    private static void WriteField(TextWriter writer, string name, string? value, string? type = null)
    {
        if (string.IsNullOrEmpty(value)) return;
        int byteCount = Encoding.UTF8.GetByteCount(value);
        writer.Write($"<{name}:{byteCount}{(type is null ? string.Empty : ":" + type)}>{value} ");
    }

    [GeneratedRegex(@"<(?<name>[A-Za-z0-9_]+):(?<length>\d+)(?::[^>]*)?>", RegexOptions.IgnoreCase)]
    private static partial Regex FieldRegex();
}
